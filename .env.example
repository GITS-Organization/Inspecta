# Replace with at least 32 random UTF-8 bytes before starting the API.
JWT_SIGNING_KEY=
JWT_ISSUER=Inspecta.Api
JWT_AUDIENCE=Inspecta.Client

# Optional until coordinator email mailboxes are configured. Keep stable between deployments.
# Generate a Base64-encoded random 32-byte key; never commit the real value.
IMAP_ENCRYPTION_KEY=

API_PORT=8080
SWAGGER_ENABLED=true

# Required: PostgreSQL ADO.NET connection string. Do not commit real credentials.
INSPECTA_CONNECTION_STRING=

# Required together to seed the initial Admin. Password must satisfy the API password policy.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: comma-separated browser frontend origins, for example https://app.example.com
CORS_ALLOWED_ORIGINS=
