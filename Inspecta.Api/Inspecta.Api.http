@baseUrl = http://localhost:5238
@requestId = 00000000-0000-0000-0000-000000000000
@clientId = 00000000-0000-0000-0000-000000000000
@managerId = 00000000-0000-0000-0000-000000000000
@userId = 00000000-0000-0000-0000-000000000000
@itemId = 00000000-0000-0000-0000-000000000000
@quoteId = 00000000-0000-0000-0000-000000000000

### Health
GET {{baseUrl}}/health

### @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Replace-With-Your-Admin-Password"
}

### Copy accessToken from the login response into this variable
@token = replace-with-access-token

### Current identity
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{token}}

### Refresh tokens
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "replace-with-refresh-token"
}

### Create a Technical Manager account (Admin; defaults to a one-month subscription)
POST {{baseUrl}}/api/v1/technical-managers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "manager@example.com",
  "fullName": "Technical Manager",
  "password": "Replace-With-Strong-Password",
  "subscriptionMonths": 12
}

### Activate/reactivate a Technical Manager subscription (Admin; end date may be null for no expiry)
PUT {{baseUrl}}/api/v1/technical-managers/{{managerId}}/subscription
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subscriptionStatus": "active",
  "subscriptionEndDate": "2027-10-26T00:00:00Z"
}

### Suspend a Technical Manager subscription and their team's access (Admin)
PUT {{baseUrl}}/api/v1/technical-managers/{{managerId}}/subscription
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subscriptionStatus": "suspended",
  "subscriptionEndDate": "2027-10-26T00:00:00Z"
}

### List users (Admin; optional filters: managerId, role, isActive, includeDeleted)
GET {{baseUrl}}/api/v1/users?managerId={{managerId}}&isActive=true&includeDeleted=false
Authorization: Bearer {{token}}

### Create a user (Admin)
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "inspector@example.com",
  "fullName": "Inspector",
  "password": "Replace-With-Strong-Password",
  "role": "inspector",
  "managerId": "{{managerId}}"
}

### Get a user (Admin)
GET {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

### Update a user profile (Admin)
PUT {{baseUrl}}/api/v1/users/{{userId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Inspector Updated",
  "role": "inspector",
  "managerId": "{{managerId}}",
  "qualifications": [],
  "isOnLeave": false,
  "leaveUntil": null
}

### Enable or suspend a user without deleting its data (Admin)
PUT {{baseUrl}}/api/v1/users/{{userId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": false
}

### Soft-delete a user (Admin; record is retained)
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
### List clients
GET {{baseUrl}}/api/v1/clients?includeArchived=false
Authorization: Bearer {{token}}

### Create a client
POST {{baseUrl}}/api/v1/clients
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example Client",
  "isCompany": true,
  "hasContract": true,
  "notes": "Client notes",
  "contacts": [
    {
      "name": "Operations Contact",
      "email": "operations@example.com",
      "phone": "+201000000000",
      "isPrimary": true
    }
  ]
}

### Get a client
GET {{baseUrl}}/api/v1/clients/{{clientId}}
Authorization: Bearer {{token}}

### Archive a client
DELETE {{baseUrl}}/api/v1/clients/{{clientId}}
Authorization: Bearer {{token}}

### List items
GET {{baseUrl}}/api/v1/equipment?clientId={{clientId}}&includeArchived=false
Authorization: Bearer {{token}}

### Create an item
POST {{baseUrl}}/api/v1/equipment
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clientId": "{{clientId}}",
  "name": "Overhead Crane",
  "itemType": "equipment",
  "locationInsideClientLocation": "Warehouse A, Bay 2",
  "notes": "Annual inspection"
}

### Get an item
GET {{baseUrl}}/api/v1/equipment/{{itemId}}
Authorization: Bearer {{token}}

### Update an item
PUT {{baseUrl}}/api/v1/equipment/{{itemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clientId": "{{clientId}}",
  "name": "Overhead Crane",
  "itemType": "equipment",
  "locationInsideClientLocation": "Warehouse A, Bay 2",
  "notes": "Updated notes"
}

### Record an item inspection
POST {{baseUrl}}/api/v1/equipment/{{itemId}}/inspections
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inspectedAt": "2026-10-26T09:00:00Z",
  "nextDueAt": "2027-10-26T09:00:00Z"
}

### Archive an item
DELETE {{baseUrl}}/api/v1/equipment/{{itemId}}
Authorization: Bearer {{token}}

### Create an inspection request
POST {{baseUrl}}/api/v1/requests
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clientId": "{{clientId}}",
  "clientName": "Example Client",
  "location": "Cairo",
  "subject": "Annual crane inspection",
  "items": [
    {
      "name": "Overhead Crane",
      "quantity": 1,
      "capacity": "10 t"
    }
  ]
}

### List requests visible to current user
GET {{baseUrl}}/api/v1/requests
Authorization: Bearer {{token}}

### Get a request
GET {{baseUrl}}/api/v1/requests/{{requestId}}
Authorization: Bearer {{token}}

### Transition a request
POST {{baseUrl}}/api/v1/requests/{{requestId}}/transitions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "quote_draft",
  "note": "Request reviewed"
}

### Assign an inspector
POST {{baseUrl}}/api/v1/requests/{{requestId}}/assignment
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inspectorId": "{{userId}}",
  "scheduledAt": "2026-11-02T09:00:00Z",
  "note": "Site visit"
}

### List quote revisions
GET {{baseUrl}}/api/v1/requests/{{requestId}}/quotes
Authorization: Bearer {{token}}

### Create a quote revision
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amountPiastres": 150000,
  "validUntil": "2026-11-15T23:59:00Z"
}

### Send a quote
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/send
Authorization: Bearer {{token}}

### Record a quote decision
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/decision
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "decision": "accepted",
  "note": "Approved by client"
}

### Get a certificate
GET {{baseUrl}}/api/v1/requests/{{requestId}}/certificate
Authorization: Bearer {{token}}

### Save a certificate draft
PUT {{baseUrl}}/api/v1/requests/{{requestId}}/certificate/draft
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "texts": {},
  "dates": {},
  "answers": {},
  "functionCheck": "unanswered",
  "finalResult": null
}

### Submit a certificate
POST {{baseUrl}}/api/v1/requests/{{requestId}}/certificate/submit
Authorization: Bearer {{token}}

### Review a certificate
POST {{baseUrl}}/api/v1/requests/{{requestId}}/certificate/review
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "approve": false,
  "note": "Please update the inspection details"
}

### Logout
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "refreshToken": "replace-with-refresh-token"
}
