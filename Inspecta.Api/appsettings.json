{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Inspecta.Api",
    "Audience": "Inspecta.Client",
    "AccessTokenMinutes": 10
  },
  "Swagger": {
    "Enabled": true
  },
  "Requests": {
    "AutoRegisterEquipment": false
  },
  "QuoteDelivery": {
    "Enabled": false
  },
  "CertificateDelivery": {
    "Enabled": false
  },
  "Certificates": {
    "PublicBaseUrl": "https://api.gitsplatform.com"
  },
  "AllowedHosts": "*"
}
