@baseUrl = http://localhost:5238
@accessToken = replace-with-coordinator-access-token
@managerToken = replace-with-manager-access-token
@adminToken = replace-with-admin-access-token
@coordinatorId = replace-with-coordinator-id
@draftId = replace-with-draft-id
@managerId = replace-with-manager-id

### Create a coordinator with IMAP access
POST {{baseUrl}}/api/v1/manager/team
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "coordinator@example.com",
  "fullName": "Test Coordinator",
  "password": "ChangeThisStrongPassword123!",
  "role": "coordinator",
  "emailConfig": {
    "imapServer": "imap.example.com",
    "imapPort": 993,
    "emailUsername": "coordinator@example.com",
    "password": "replace-with-mailbox-password",
    "useSsl": true
  }
}

### Update coordinator mailbox configuration
PUT {{baseUrl}}/api/v1/manager/team/{{coordinatorId}}/email-config
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "imapServer": "imap.example.com",
  "imapPort": 993,
  "emailUsername": "coordinator@example.com",
  "password": "replace-with-mailbox-password",
  "useSsl": true
}

@requestId = replace-with-request-id
@itemId = replace-with-request-item-id

### List requests (a coordinator sees manual requests of the team and the email requests of their own mailbox)
GET {{baseUrl}}/api/v1/requests
Authorization: Bearer {{accessToken}}

### Tab counts: real requests (total and per status) and maybe emails
GET {{baseUrl}}/api/v1/requests/summary
Authorization: Bearer {{accessToken}}

### Second page of requests, filtered by status and searched by text
GET {{baseUrl}}/api/v1/requests?page=2&pageSize=20&status=request_received&q=noor
Authorization: Bearer {{accessToken}}

### Maybe tab: emails from unknown senders (deleted automatically after 7 days)
GET {{baseUrl}}/api/v1/requests?triage=maybe
Authorization: Bearer {{accessToken}}

### Turn a maybe email into a real request (owning coordinator)
POST {{baseUrl}}/api/v1/requests/{{requestId}}/confirm
Authorization: Bearer {{accessToken}}

### Delete a maybe email now (owning coordinator; only maybe emails)
DELETE {{baseUrl}}/api/v1/requests/{{requestId}}
Authorization: Bearer {{accessToken}}

### List the client senders of the team (Admin: add ?managerId=)
GET {{baseUrl}}/api/v1/client-mail-rules
Authorization: Bearer {{managerToken}}

### Add a client domain (mail from it becomes a request immediately)
POST {{baseUrl}}/api/v1/client-mail-rules
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "pattern": "alnoor-industries.example"
}

### Add one client address linked to a client record
POST {{baseUrl}}/api/v1/client-mail-rules
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "pattern": "mohammed.ali@alnoor-industries.example",
  "clientId": "replace-with-client-id"
}

### Admin: add a client domain for one technical manager
POST {{baseUrl}}/api/v1/client-mail-rules
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "pattern": "alnoor-industries.example",
  "managerId": "{{managerId}}"
}

### Remove a client sender
DELETE {{baseUrl}}/api/v1/client-mail-rules/replace-with-rule-id
Authorization: Bearer {{managerToken}}

### Admin: preview how many untouched imported email requests would be deleted (dryRun is the default)
POST {{baseUrl}}/api/v1/admin/email-backlog/cleanup
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "createdBefore": "2026-10-29T00:00:00Z"
}

### Admin: delete them for real (permanent)
POST {{baseUrl}}/api/v1/admin/email-backlog/cleanup
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "createdBefore": "2026-10-29T00:00:00Z",
  "dryRun": false
}

### Technical Manager: all requests of the team
GET {{baseUrl}}/api/v1/requests
Authorization: Bearer {{managerToken}}

### Admin: requests of one technical manager
GET {{baseUrl}}/api/v1/requests?managerId={{managerId}}
Authorization: Bearer {{adminToken}}

### Get one request (check missingFields to see what is still empty)
GET {{baseUrl}}/api/v1/requests/{{requestId}}
Authorization: Bearer {{accessToken}}

### Read the original email of an email request ("Read full email")
GET {{baseUrl}}/api/v1/requests/{{requestId}}/email
Authorization: Bearer {{accessToken}}

### Complete client, location, preferred date and access notes (owning coordinator only)
PUT {{baseUrl}}/api/v1/requests/{{requestId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "clientName": "Al Noor Heavy Industries Ltd.",
  "location": "Industrial City, Saudi Arabia",
  "preferredDate": "2026-11-09T00:00:00Z",
  "accessNotes": "Compressor Room, shutdown window Thursday evenings. Vessels depressurised by maintenance."
}

### Save the whole request screen in one call (details plus the full equipment list, all or nothing)
PUT {{baseUrl}}/api/v1/requests/{{requestId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "clientName": "Al Noor Heavy Industries Ltd.",
  "location": "Industrial City, Saudi Arabia",
  "preferredDate": "2026-11-09T00:00:00Z",
  "accessNotes": "Compressor Room, shutdown window Thursday evenings.",
  "expectedUpdatedAt": "replace-with-the-updatedAt-you-read",
  "items": [
    { "id": "replace-with-existing-item-id", "name": "Air receiver pressure vessel - 2,000 L / 10 bar", "type": "Air receiver pressure vessel", "capacity": "2,000 L / 10 bar", "quantity": 3, "location": "Industrial City, Saudi Arabia" },
    { "name": "Safety relief valve - DN40", "type": "Safety relief valve", "quantity": 6 }
  ]
}

### Add an equipment item
POST {{baseUrl}}/api/v1/requests/{{requestId}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Air receiver pressure vessel - 2,000 L / 10 bar",
  "type": "Air receiver pressure vessel",
  "capacity": "2,000 L / 10 bar",
  "quantity": 3,
  "location": "Industrial City, Saudi Arabia"
}

### Replace an equipment item
PUT {{baseUrl}}/api/v1/requests/{{requestId}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Air receiver pressure vessel - 2,000 L / 10 bar",
  "type": "Air receiver pressure vessel",
  "capacity": "2,000 L / 10 bar",
  "quantity": 2,
  "location": "Compressor room"
}

### Remove an equipment item
DELETE {{baseUrl}}/api/v1/requests/{{requestId}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}

### Reject the request (from a new request, a draft or a sent quotation; no email is sent)
POST {{baseUrl}}/api/v1/requests/{{requestId}}/reject
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Outside our service area"
}

### Quotation steps cannot be moved with transitions (409 quote_flow); transitions only drive the work after acceptance
POST {{baseUrl}}/api/v1/requests/{{requestId}}/transitions
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "status": "certificate_submitted"
}

### Legacy: quotation drafts created from mail before requests replaced them (read and edit only, no new ones are created)
### List this coordinator's legacy quotation drafts
GET {{baseUrl}}/api/v1/quotation-drafts
Authorization: Bearer {{accessToken}}

### List all drafts in a Technical Manager's team
GET {{baseUrl}}/api/v1/quotation-drafts
Authorization: Bearer {{managerToken}}

### Admin: list drafts for one technical manager
GET {{baseUrl}}/api/v1/quotation-drafts?managerId={{managerId}}
Authorization: Bearer {{adminToken}}

### Update a quotation draft
PUT {{baseUrl}}/api/v1/quotation-drafts/{{draftId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "clientName": "Acme Industries",
  "location": "Cairo",
  "machineDetails": "Model: X-100; Serial: SN-42; Issue: Motor vibration",
  "amountPiastres": 25000000,
  "validUntil": "2026-12-01T00:00:00Z"
}

### Counter-offer on a draft
POST {{baseUrl}}/api/v1/quotation-drafts/{{draftId}}/decision
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "counter_offered"
}

### Accept a quotation request
POST {{baseUrl}}/api/v1/quotation-drafts/{{draftId}}/decision
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "accepted"
}

### Reject a quotation request
POST {{baseUrl}}/api/v1/quotation-drafts/{{draftId}}/decision
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "rejected"
}

### Admin: download a sample quotation PDF to check PDF generation on the server
GET {{baseUrl}}/api/v1/admin/pdf/sample
Authorization: Bearer {{adminToken}}

@quoteId = replace-with-quote-id

### Open a quotation on a request (copies every request item with an empty price)
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "validForDays": 14
}

### Save the quotation draft: a price for every request item (piastres), scope, notes and message
PUT {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "items": [
    { "requestItemId": "replace-with-request-item-id", "unitPricePiastres": 1200000 },
    { "requestItemId": "replace-with-other-request-item-id", "unitPricePiastres": 850000 }
  ],
  "validForDays": 14,
  "scopeOfWork": ["Load and functional test", "Visual inspection", "Ultrasonic thickness measurements"],
  "notes": ["Pricing excludes VAT.", "Payment terms: 90 days from invoice date."],
  "message": "Thank you for your enquiry. Please find our offer attached."
}

### Get the quotation with its items, totals and missing prices
GET {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}
Authorization: Bearer {{accessToken}}

### Preview the quotation as a PDF
GET {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/pdf
Authorization: Bearer {{accessToken}}

### Send the offer: emails the PDF as a reply to the original sender, then marks the quotation as sent
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/send
Authorization: Bearer {{accessToken}}

### Accept the request: closes the quotation as accepted and emails the PDF to the original sender
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/accept
Authorization: Bearer {{accessToken}}

### Counter offer: while the request is quote_sent, this opens the next revision with the previous prices
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Change the proposal number while the quotation is a draft (add "proposalNumber" to the PUT body)
PUT {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "proposalNumber": "INT/417/2026 rev01",
  "items": [
    { "requestItemId": "replace-with-request-item-id", "unitPricePiastres": 1200000 },
    { "requestItemId": "replace-with-other-request-item-id", "unitPricePiastres": 850000 }
  ]
}

### Mailbox with a custom outgoing (SMTP) server
PUT {{baseUrl}}/api/v1/manager/team/{{coordinatorId}}/email-config
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "imapServer": "imap.example.com",
  "imapPort": 993,
  "emailUsername": "coordinator@example.com",
  "password": "replace-with-mailbox-password",
  "useSsl": true,
  "smtpServer": "smtp.example.com",
  "smtpPort": 465,
  "smtpUseSsl": true
}

### Record an accepted outcome without sending an email
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/decision
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "decision": "accepted"
}

### Close a sent quotation as rejected (a reason is required)
POST {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}/decision
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "decision": "rejected",
  "note": "Price is above our budget"
}

### Set who the offer is addressed to ("Attention" on the PDF cover) while the quotation is a draft
PUT {{baseUrl}}/api/v1/requests/{{requestId}}/quotes/{{quoteId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "contactName": "Eng. Reem",
  "items": [
    { "requestItemId": "replace-with-request-item-id", "unitPricePiastres": 1200000 },
    { "requestItemId": "replace-with-other-request-item-id", "unitPricePiastres": 850000 }
  ]
}
