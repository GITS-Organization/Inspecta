rules_version = '2';

// Role checks run on the server for every read and write (BR-01.3).
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Signed in, has a profile, and hasn't been deactivated (BR-01.4).
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }

    // "supervisor" was folded into "coordinator". Accounts still stored with
    // the old role keep working as coordinators until their document is
    // updated.
    function hasRole(role) {
      return isActive()
        && (profile().role == role
            || (role == 'coordinator' && profile().role == 'supervisor'));
    }

    match /users/{uid} {
      // Everyone can read their own profile, even when deactivated, so the
      // app can notice and sign them out. Coordinators read inspectors to
      // assign jobs; admins read everyone.
      allow read: if (signedIn() && request.auth.uid == uid)
        || hasRole('admin')
        || ((hasRole('coordinator') || hasRole('technical_manager')) && resource.data.role == 'inspector');

      // A user may only stamp their own lastLogin with the server time.
      // Feature 04: a coordinator may mark/clear an inspector's leave —
      // only that one field, only on an inspector's profile.
      allow update: if hasRole('admin')
        || (isActive()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
            && request.resource.data.lastLogin == request.time)
        || (hasRole('coordinator')
            && resource.data.role == 'inspector'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onLeaveUntil']));

      allow create, delete: if hasRole('admin');
    }

    match /requests/{id} {
      // When the write sets `certificateSubmittedAt`, it is the server time.
      function submittedAtIsServerTime() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['certificateSubmittedAt'])
          || request.resource.data.certificateSubmittedAt == request.time;
      }

      // Feature 02's inbox is the coordinator's; the technical manager only
      // gets a read-only view once a job is further along (00-overview.md's
      // permissions matrix — "View any job (read-only)").
      allow read: if hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin')
        // Feature 05: an inspector reads only jobs assigned to them —
        // the app always queries `where inspectorId == uid` to match.
        || (hasRole('inspector') && resource.data.inspectorId == request.auth.uid);

      // BR-02.9: only coordinators edit request details.
      allow create, delete: if hasRole('coordinator');

      // A coordinator owns a request from intake to assignment (Feature 04
      // included), so they may update any of its fields.
      allow update: if hasRole('coordinator')
        // Feature 05: the assigned inspector accepts, declines (handing
        // the job back to the coordinator's queue) or starts their own
        // job — each move touches only the fields it needs.
        || (hasRole('inspector') && resource.data.inspectorId == request.auth.uid
            && (
                 (resource.data.status == 'assigned'
                   && request.resource.data.status == 'task_accepted'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                 || (resource.data.status == 'assigned'
                   && request.resource.data.status == 'quote_accepted'
                   && request.resource.data.inspectorId == null
                   && request.resource.data.scheduledAt == null
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'inspectorId', 'scheduledAt',
                      ]))
                 || (resource.data.status == 'task_accepted'
                   && request.resource.data.status == 'in_progress'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                 // Submitting also stamps when, so the technical manager's
                 // Review tab can list the most recent first — only ever
                 // with the server time.
                 || (resource.data.status == 'in_progress'
                   && request.resource.data.status == 'certificate_submitted'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'certificateSubmittedAt'])
                   && submittedAtIsServerTime())
                 // Feature 05: resubmitting after a technical manager
                 // sends a certificate back for changes.
                 || (resource.data.status == 'certificate_returned'
                   && request.resource.data.status == 'certificate_submitted'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'certificateSubmittedAt'])
                   && submittedAtIsServerTime())
               ))
        // Feature 06: a technical manager approves (handing it back to the
        // coordinator to send to the client) or returns a submitted
        // certificate — status only.
        || (hasRole('technical_manager')
            && resource.data.status == 'certificate_submitted'
            && (request.resource.data.status == 'certificate_approved'
                || request.resource.data.status == 'certificate_returned')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    match /certificates/{id} {
      // Feature 05: one certificate per job (doc id == the request's id),
      // owned by the inspector it's assigned to. Ownership is checked
      // against the *request* doc, not the certificate doc itself — the
      // certificate doesn't exist yet the first time the inspector opens
      // the screen (`resource` is null for a read of a nonexistent doc,
      // so checking `resource.data` directly would fail closed).
      function ownsJob() {
        return get(/databases/$(database)/documents/requests/$(id)).data.inspectorId == request.auth.uid;
      }

      // The public verification page (the dashboard's /verify/{id}, opened by
      // scanning the QR on a certificate the client was sent): anyone may read
      // ONE issued certificate by its document id — an unguessable job id, put
      // in the QR — and nobody can list or query certificates without signing
      // in. A certificate counts as issued once approval gave it a code.
      allow get: if resource.data.get('verificationCode', '') != '';

      allow read: if hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin')
        || (hasRole('inspector') && ownsJob())
        // An inspector's Profile counts their own certificates with one query
        // `where inspectorId == uid`, which `ownsJob()` can't vouch for.
        || (hasRole('inspector') && resource.data.inspectorId == request.auth.uid);

      allow create: if hasRole('inspector')
        && ownsJob()
        && request.resource.data.inspectorId == request.auth.uid;

      // Editable while drafting, and again after a technical manager
      // sends it back — locked at every other point in the job's
      // lifecycle. No separate flag on the certificate itself needed.
      allow update: if hasRole('inspector')
        && ownsJob()
        && (get(/databases/$(database)/documents/requests/$(id)).data.status == 'in_progress'
            || get(/databases/$(database)/documents/requests/$(id)).data.status == 'certificate_returned');

      // Feature 06: a technical manager reviews a submitted certificate —
      // only the review fields (the QR code issued with an approval included),
      // and only while it's awaiting review.
      allow update: if hasRole('technical_manager')
        && get(/databases/$(database)/documents/requests/$(id)).data.status == 'certificate_submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'reviewNote', 'reviewerComments', 'reviewerName', 'reviewerLicense',
             'sentTo', 'signature', 'reviewedAt',
             'certificateNumber', 'verificationCode', 'qrData', 'issuedFor',
           ]);

      // The coordinator sends an approved certificate on to the client —
      // recording who it went to, and nothing else.
      allow update: if hasRole('coordinator')
        && get(/databases/$(database)/documents/requests/$(id)).data.status == 'certificate_approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentTo']);

      allow delete: if false;
    }

    match /timesheets/{id} {
      // One entry per job (doc id == the request's id): the time the
      // inspector spent and the price they set, reviewed by a coordinator.
      // An inspector reads only their own (the app always queries
      // `where inspectorId == uid` to match); coordinators and admins read
      // all of them. Ownership of the *job* is checked against the request
      // doc, as for certificates, since the entry doesn't exist yet the
      // first time it's written.
      function ownsJob() {
        return get(/databases/$(database)/documents/requests/$(id)).data.inspectorId == request.auth.uid;
      }

      // The rate this inspector has set — 0 until they've set one. An
      // entry's price is calculated from it, so the server holds the rate
      // rather than trusting the one the client sends.
      function currentRate() {
        let settings = /databases/$(database)/documents/timesheetSettings/$(request.auth.uid);
        return exists(settings) ? get(settings).data.hourlyRatePiastres : 0;
      }

      // A time or money field, if present, is a whole number >= 0 — minutes
      // for the activities, piastres for the costs.
      function validAmount(field) {
        let value = request.resource.data.get(field, 0);
        return value is int && value >= 0;
      }

      // What an inspector's save must look like: their own uid, whole
      // numbers >= 0, the server time, and always `pending` — every save
      // (re)submits the entry for review. `minutes` is the net working
      // time, so it must equal the paid activities; the unpaid break is
      // deducted, never added. The price is never the client's to choose:
      // it must be those minutes at the inspector's own current hourly
      // rate, rounded half up to the piastre (the same formula as
      // TimesheetPricing in the app).
      function validSubmission() {
        let entry = request.resource.data;
        return entry.inspectorId == request.auth.uid
          && validAmount('inspectionMinutes')
          && validAmount('reportMinutes')
          && validAmount('waitingMinutes')
          && validAmount('unpaidBreakMinutes')
          && validAmount('internalTransportPiastres')
          && validAmount('externalTransportPiastres')
          && entry.minutes is int && entry.minutes >= 0
          && entry.minutes == entry.get('inspectionMinutes', 0)
                            + entry.get('reportMinutes', 0)
                            + entry.get('waitingMinutes', 0)
          && entry.hourlyRatePiastres is int && entry.hourlyRatePiastres == currentRate()
          && entry.pricePiastres is int
          && entry.pricePiastres == math.floor((entry.minutes * entry.hourlyRatePiastres + 30) / 60)
          && entry.status == 'pending'
          && entry.updatedAt == request.time;
      }

      allow read: if hasRole('admin')
        || hasRole('coordinator')
        || (hasRole('inspector') && resource.data.inspectorId == request.auth.uid);

      allow create: if hasRole('inspector')
        && ownsJob()
        && validSubmission()
        && request.resource.data.keys().hasOnly([
             'inspectorId', 'minutes', 'inspectionMinutes', 'reportMinutes', 'waitingMinutes',
             'unpaidBreakMinutes', 'internalTransportPiastres', 'externalTransportPiastres',
             'hourlyRatePiastres', 'pricePiastres', 'status', 'updatedAt',
           ]);

      // An inspector may change an entry until a coordinator approves it —
      // then it's locked — and only their own fields (the time, price and
      // status): the review fields stay a coordinator's. An entry logged
      // before review existed has no `status`; it counts as pending.
      allow update: if hasRole('inspector')
        && ownsJob()
        && resource.data.inspectorId == request.auth.uid
        && resource.data.get('status', 'pending') != 'approved'
        && validSubmission()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'minutes', 'inspectionMinutes', 'reportMinutes', 'waitingMinutes', 'unpaidBreakMinutes',
             'internalTransportPiastres', 'externalTransportPiastres',
             'hourlyRatePiastres', 'pricePiastres', 'status', 'updatedAt',
           ]);

      // A coordinator decides a pending entry: approve it, or return it
      // with a reason. Only the status and review fields may change — never
      // the time or price — and the review is stamped with their own uid
      // and the server time. A return needs a note; an approval carries
      // none. An admin (the management dashboard) may decide too.
      allow update: if (hasRole('coordinator') || hasRole('admin'))
        && resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.status in ['approved', 'returned']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'reviewNote', 'reviewedBy', 'reviewerName', 'reviewedAt',
           ])
        && (request.resource.data.status == 'approved'
            ? !('reviewNote' in request.resource.data)
            : request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() > 0);

      allow delete: if false;
    }

    match /signatures/{uid} {
      // A technical manager's own signature, drawn once and reused on every
      // certificate they approve (doc id == uid). Only its owner reads or
      // sets it. The strokes are a bounded list, so it can't be used as
      // free storage.
      allow read: if hasRole('technical_manager') && request.auth.uid == uid;

      allow create, update: if hasRole('technical_manager')
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['strokes', 'updatedAt'])
        && request.resource.data.strokes is list
        && request.resource.data.strokes.size() <= 100
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /timesheetSettings/{uid} {
      // An inspector's hourly rate, one doc per inspector (doc id == uid).
      // It's pay data, so only its owner reads or sets it — admins can read
      // it. Coordinators don't need it: an entry carries the rate it was
      // priced with.
      allow read: if hasRole('admin')
        || (hasRole('inspector') && request.auth.uid == uid);

      allow create, update: if hasRole('inspector')
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hourlyRatePiastres', 'updatedAt'])
        && request.resource.data.hourlyRatePiastres is int
        && request.resource.data.hourlyRatePiastres >= 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /requests/{id}/events/{eventId} {
      // 00-overview.md §8: every status change is logged and can't be
      // edited — append-only, same readers as the request itself.
      allow read: if hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin');
      // A coordinator's assignment write, or an inspector's own
      // accept/decline/start write, logs an event alongside it (see
      // requests/{id}'s update rule above).
      allow create: if hasRole('coordinator') || hasRole('inspector') || hasRole('technical_manager');
      allow update, delete: if false;
    }

    match /clients/{id} {
      // Same readers as requests/quotations (00-overview.md's
      // permissions matrix — clients are shared reference data).
      allow read: if hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin');

      // Only coordinators maintain the roster (BR-02.4/02.9's spirit —
      // matching senders and keeping client records is their job). Admins
      // may too, so the management dashboard can create clients.
      allow create, update: if hasRole('coordinator') || hasRole('admin');
      allow delete: if false;
    }

    match /quotations/{id} {
      // Same readers as the request it belongs to (Feature 03 §5).
      allow read: if hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin');

      // BR-03.4: a sent quotation's price/items/type are immutable.
      // Creating is always allowed. Updating is allowed either while the
      // doc is still a draft (covers the draft→sent transition, which
      // can touch any field), or — once sent — only for the narrow set
      // of fields BR-03.6's client-response logging and a reminder
      // timestamp touch; nothing else may change after sending.
      allow create: if hasRole('coordinator');
      allow update: if hasRole('coordinator')
        && (resource.data.status == 'draft'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'clientResponseOutcome', 'clientCounterPricePiastres',
                 'clientResponseNote', 'clientRespondedAt', 'lastReminderAt', 'updatedAt',
               ]));
      allow delete: if false;
    }

    // The public marketing site (website/): its "Request a demo" and
    // "Contact our team" form creates one document per submission, with no
    // sign-in. Anyone may create a well-formed one; nothing can be read
    // back, changed or deleted through a client (admins can read them in
    // the app, and the Firebase console always can). Every field is
    // bounded so the collection can't be used as free storage.
    match /demoRequests/{id} {
      function validDemoRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['type', 'name', 'email', 'company', 'role', 'message', 'lang', 'source', 'createdAt'])
          && d.keys().hasAll(['type', 'name', 'email', 'company', 'role', 'message', 'lang', 'source', 'createdAt'])
          && d.type in ['demo', 'contact']
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
          && d.email is string && d.email.size() <= 254
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
          && d.company is string && d.company.size() >= 2 && d.company.size() <= 120
          && d.role is string && d.role.size() <= 40
          && d.message is string && d.message.size() <= 2000
          && d.lang in ['en', 'ar']
          && d.source == 'website'
          && d.createdAt is timestamp
          && d.createdAt >= request.time - duration.value(1, 'd')
          && d.createdAt <= request.time + duration.value(1, 'd');
      }

      allow create: if validDemoRequest();
      allow read: if hasRole('admin');
      allow update, delete: if false;
    }

    // Deny everything else until each feature adds its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
