# Copy to `.env` on the server (`cp .env.example .env`), then fill it. NEVER commit `.env` and never paste its values in chat.
# `./gen-secrets.sh` prints fresh values for the three secrets below; run it on the server and paste them into `.env` yourself.

# --- Public address and certificate e-mail ---
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# --- Database (created empty on the first start; the API builds the tables itself) ---
POSTGRES_DB=inspecta
POSTGRES_USER=inspecta
POSTGRES_PASSWORD=

# --- API secrets ---
# At least 32 random characters.
JWT_SIGNING_KEY=
# Base64 of exactly 32 random bytes. Keep it forever: mailbox passwords saved with it cannot be read with another key.
IMAP_ENCRYPTION_KEY=

# --- The first platform administrator (used on the first start only; change the password after the first sign-in) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Behaviour ---
SWAGGER_ENABLED=false
# Exact https origins of the web frontend, comma separated (empty for none).
CORS_ALLOWED_ORIGINS=
# Where the QR code on a certificate points. Default: https://API_DOMAIN. The old address of the first customer keeps working while it still resolves to this server.
CERTIFICATES_PUBLIC_BASE_URL=
# Switch on only after a test e-mail went through (see the runbook).
QUOTE_DELIVERY_ENABLED=false
CERTIFICATE_DELIVERY_ENABLED=false
EMAIL_SYNC_INTERVAL_SECONDS=15
JOB_REPORTS_RETENTION_DAYS=30
JOB_REPORTS_MAX_EMAIL_BYTES=17825792

# --- Outlook / Microsoft 365 sign-in (leave empty until the Microsoft app exists) ---
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# https://API_DOMAIN/api/v1/email-connection/microsoft/callback (add the same address in the Microsoft app)
MICROSOFT_OAUTH_REDIRECT_URI=

# --- Backups (optional off-server copy: an rclone remote name, e.g. `storagebox`; empty keeps copies on this server only) ---
BACKUP_KEEP_DAYS=14
# Full rclone destination, for example b2backup:my-bucket/inspecta (remote name, bucket, folder). Empty keeps copies on this server only.
RCLONE_REMOTE=
